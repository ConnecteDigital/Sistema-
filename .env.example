# Copie para .env.local (desenvolvimento) e preencha. Na Vercel: Settings → Environment Variables.
# NUNCA commitar valores reais.

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...          # só no servidor; ignora RLS

# Frase longa e aleatória para criptografar as chaves da SerpApi no banco.
# Gere com:  openssl rand -base64 32
# Se trocar depois, as chaves já cadastradas precisam ser cadastradas de novo.
KEYS_ENCRYPTION_SECRET=

# Opcional: se preenchido, pede este código UMA vez por navegador (fica lembrado 1 ano).
# Vazio = sistema abre direto, sem nada.
ACESSO_CODIGO=

# Opcionais (fases seguintes)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
ANTHROPIC_API_KEY=
CRON_SECRET=

# WhatsApp Cloud API (oficial da Meta) — módulo Disparos
WHATSAPP_TOKEN=                  # token PERMANENTE de "usuário do sistema" (Business Manager)
WHATSAPP_PHONE_NUMBER_ID=        # ID do número (WhatsApp Manager → API Setup)
WHATSAPP_WABA_ID=                # ID da conta do WhatsApp Business
WHATSAPP_VERIFY_TOKEN=           # você inventa; o mesmo texto vai no cadastro do webhook na Meta
WHATSAPP_APP_SECRET=             # recomendado: App → Configurações → Básico → Chave secreta do app
